{
  "name": "horsebook-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:concurrency": "node --test tests/concurrency.integration.mjs",
    "test:ui": "playwright test",
    "db:apply": "node scripts/database.mjs apply",
    "db:import": "node scripts/database.mjs import",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore",
    "db:admin": "node scripts/database.mjs admin",
    "db:status": "node scripts/status.mjs",
    "backup:verify": "node scripts/verify-snapshot.mjs",
    "backup:provision": "node scripts/provision-backup.mjs",
    "import:prepare": "node scripts/prepare-import.mjs",
    "dev:test-db": "node scripts/test-server.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.5",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
